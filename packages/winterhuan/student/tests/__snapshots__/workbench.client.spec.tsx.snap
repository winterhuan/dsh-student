// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`learning workbench > puts answer controls before optional question goals and opens marking directly 1`] = `"<header class="student-top"><nav class="student-tabs _navigation_e9d83e" aria-label="Learning desk"><button type="button" aria-pressed="true">Today</button><button type="button" aria-pressed="false">Knowledge and progress</button><button type="button" aria-label="Practice and marking" aria-pressed="false">Practice and marking</button><button type="button" aria-pressed="false">Profile and summary</button></nav><div class="student-toolbar"><nav class="student-subjects" aria-label="Subject"><button type="button" aria-pressed="false">Chinese</button><button type="button" aria-pressed="true">Math</button><button type="button" aria-pressed="false">English</button></nav><span class="student-muted">Updates automatically</span></div></header><section class="student-status"><div class="_statusHeading_e9d83e"><p>小禾 · Math · Foundations</p><p>Stars today: 0</p></div><details><summary>Study progress and methods</summary><p>Due for review: 0 · Weak points: 0</p><p class="student-muted">Circle givens and the question, draw or model, explain the steps in your own words, then check with the inverse or another method.</p></details></section><section class="student-focus"><h3>加法</h3><div class="_taskLayout_e9d83e "><div class="_taskPrompt_e9d83e"><p class="student-question">8 + 7 等于多少？</p></div><div class="_answerArea_e9d83e"><form><fieldset><label>My answer<input name="answer" aria-label="My answer" required="" maxlength="2000" value=""></label><button class="student-primary" type="submit">Submit answer</button><button type="button">Give me a hint</button><button type="button">I can't do this</button></fieldset></form></div></div><details class="_taskDetails_e9d83e"><summary>Question goal and learning steps</summary><p class="student-muted">Learning goal: 凑十加法</p><ol class="student-simon" aria-label="Simon four steps"><li class="student-simon-done">Prepare / demo</li><li class="student-simon-done">Explain / guide</li><li class="student-simon-current" aria-current="step">Try alone</li><li>Evaluate / vary</li></ol></details><p class="student-muted">Answer here, or review a microphone transcript in chat before sending it. Explanations and feedback appear in chat</p></section><form><div class="student-segments"><button type="submit">End this block</button><button type="button">Teach it like a little teacher</button></div><details class="student-fold"><summary>Optional: note today's takeaway</summary><p>Say in one sentence how you did it</p><label>What did you learn? (optional)<textarea aria-label="What did you learn? (optional)" name="reflection" maxlength="2000" placeholder="Say in one sentence how you did it"></textarea></label></details></form><details class="student-fold"><summary>Another way</summary><form><fieldset><label>Learning mode<select aria-label="Learning mode"><option value="sync">Sync</option><option value="review" disabled="">Due review</option><option value="diagnose">Check-in</option><option value="explore">Explore</option></select></label><p>Practise the confirmed school unit, or labelled foundations when that course is not confirmed yet</p><p><label>Scope<select aria-label="Scope"><option value="current">Current term</option><option value="1-first">Grade 1 · First term</option><option value="1-second">Grade 1 · Second term</option><option value="2-second">Grade 2 · Second term</option></select></label></p><p>Confirm the textbook before using School course; other activities have their own requirements</p><button type="submit" class="student-primary">Switch learning</button></fieldset></form></details><section aria-label="Interactive lesson"><h3>Interactive lesson</h3><p class="student-muted">Generate one lesson on this computer with OpenMAIC from today's goal. The tutor runs generation; this list opens the link in the browser</p><p>No interactive lessons yet</p></section>"`;
