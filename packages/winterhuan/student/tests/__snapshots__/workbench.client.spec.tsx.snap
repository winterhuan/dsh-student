// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`learning workbench > puts answer controls before optional question goals and opens marking directly 1`] = `"<header class="student-top"><nav class="student-tabs _navigation_e9d83e" aria-label="Learning desk"><button type="button" aria-pressed="true">Learning</button><button type="button" aria-pressed="false">Parent</button></nav><div class="student-toolbar"><span class="student-muted">Updates automatically</span></div></header><div class="_statusHeading_e9d83e"><p>小禾 · Learning · Math</p><button type="button">Back home</button></div><section class="student-plan"><h3>加法</h3><button type="button" class="student-primary" disabled="">Continue learning</button></section><section class="student-focus"><h3>加法</h3><div class="_taskLayout_e9d83e "><div class="_taskPrompt_e9d83e"><p class="student-question">8 + 7 等于多少？</p></div><div class="_answerArea_e9d83e"><form><fieldset><label>My answer<input name="answer" aria-label="My answer" required="" maxlength="2000" value=""></label><button class="student-primary" type="submit">Submit answer</button><button type="button">Give me a hint</button><button type="button">I can't do this</button></fieldset></form></div></div><details class="_taskDetails_e9d83e"><summary>Question goal and learning steps</summary><p class="student-muted">Learning goal: 凑十加法</p><ol class="student-simon" aria-label="Simon four steps"><li class="student-simon-done">Prepare / demo</li><li class="student-simon-done">Explain / guide</li><li class="student-simon-current" aria-current="step">Try alone</li><li>Evaluate / vary</li></ol></details></section><p class="student-muted">Answer here, or review a microphone transcript in chat before sending it. Explanations and feedback appear in chat</p><div class="_practiceActions_e9d83e"><button type="button">Pause</button><button type="button">Finish for today</button><button type="button">Change content</button></div>"`;
